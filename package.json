{
  "name": "sizo",
  "version": "1.0.0",
  "description": "SIZO — ERP SaaS SG-SST de Webcore Solutions",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "npx serve . -p 5000",
    "provision:admin": "node scripts/provision-admin.mjs",
    "provision:demo": "node scripts/provision-demo-user.mjs",
    "test": "node testing/QA/poc-jsonb-roundtrip.mjs && node scripts/test-regresion.mjs && node scripts/test-seguridad-rls.mjs",
    "test:unit": "node testing/QA/poc-jsonb-roundtrip.mjs",
    "test:mecanica": "node scripts/test-regresion.mjs",
    "test:seguridad": "node scripts/test-seguridad-rls.mjs",
    "test:estres": "node scripts/test-estres.mjs",
    "test:qa": "playwright test",
    "test:qa:unit": "playwright test --project=unit",
